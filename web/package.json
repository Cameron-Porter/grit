{
  "name": "grit-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "test:e2e": "playwright install chromium && playwright test",
    "lint": "eslint . --max-warnings=0",
    "audit": "npm audit --audit-level=moderate",
    "quality": "npm run lint && npm run typecheck && npm run test:unit && npm run test:rules && npm run build"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "^16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  }
}
