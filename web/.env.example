NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APP_URL=https://your-production-domain.example

# Stripe subscriptions (all values are server-only).
# Prefer a least-privilege restricted key (rk_) over an unrestricted secret.
STRIPE_API_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local development only: lets /dev-login sign in automatically so localhost
# doesn't need a manual login each session. It performs a real password sign-in
# (no auth bypass, RLS still applies). The route 404s unless NODE_ENV is
# development, so these have no effect in a build or a deploy — leave them
# unset everywhere except .env.local.
# Put the REAL values in web/.env.local (gitignored) — never in this file,
# which is committed to the repo.
DEV_LOGIN_EMAIL=you@example.com
DEV_LOGIN_PASSWORD=your-local-account-password

# Optional web error monitoring. Public DSN enables capture; auth token is
# server/build-only for source map uploads and must stay out of client code.
NEXT_PUBLIC_SENTRY_DSN=https://public@sentry.io/project
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=grit-pwa
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ENVIRONMENT=production
# Optional temporary diagnostics override; defaults to 0.05.
SENTRY_TRACES_SAMPLE_RATE=0.05
