{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@grit/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/rules/**/*.ts",
    "src/data/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/volumeLandmarks.ts",
    "src/utils/oneRepMax.ts",
    "__tests__/rules/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "web/node_modules"
  ]
}
